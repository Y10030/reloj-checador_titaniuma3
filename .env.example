# ==============================================================================
# Sistema de Checadas Móviles — Integración Acceso 3 TITANIUM (Vía A)
# Copie este archivo a .env y ajuste los valores de producción
# ==============================================================================

APP_ENV=development
APP_TIMEZONE=America/Mexico_City
APP_BASE_URL=http://localhost:8080
APP_TRUST_PROXY=true

# Clave maestra de cifrado AES-256-GCM para plantillas faciales (64 caracteres hex = 32 bytes)
# Generar con: php -r "echo bin2hex(random_bytes(32));"
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Usuario administrador inicial (se crea automáticamente si no existe ninguno)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=Titanium2026!

# ------------------------------------------------------------------------------
# Base de datos complementaria (mysql | sqlite)
# En producción se recomienda mysql (MySQL 8 / MariaDB en el servidor Windows)
# ------------------------------------------------------------------------------
DB_DRIVER=sqlite
DB_SQLITE_PATH=database/checador_local.sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=checador_movil
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------------------
# Integración Acceso 3 TITANIUM — Firebird 2.5 (Vía A)
# Modo: "firebird" (producción real) o "demo" (emulación local de DemoAcceso.fdb)
# ------------------------------------------------------------------------------
TITANIUM_MODE=demo
TITANIUM_FB_HOST=localhost
TITANIUM_FB_PORT=3050
TITANIUM_FB_DATABASE=C:\Program Files (x86)\Acceso3\DB\DemoAcceso.fdb
TITANIUM_FB_USER=SYSDBA
TITANIUM_FB_PASS=masterkey
TITANIUM_FB_CHARSET=UTF8

# Mapeo configurable de tablas/columnas de Firebird 2.5 (validar en DemoAcceso.fdb)
TITANIUM_TBL_EMPLEADOS=EMPLEADOS
TITANIUM_COL_EMP_ID=CLAVE
TITANIUM_COL_EMP_NOMBRE=NOMBRE
TITANIUM_COL_EMP_AP_PAT=APELLIDOPATERNO
TITANIUM_COL_EMP_AP_MAT=APELLIDOMATERNO
TITANIUM_COL_EMP_ESTATUS=ESTATUS
TITANIUM_COL_EMP_DEPTO=CLAVEDEPARTAMENTO
TITANIUM_COL_EMP_SUCURSAL=CLAVESUCURSAL
TITANIUM_VAL_ESTATUS_ALTA=Alta

TITANIUM_TBL_CHECADAS=CHECADAS
TITANIUM_COL_CHK_EMP_ID=CLAVEEMPLEADO
TITANIUM_COL_CHK_FECHA=FECHA
TITANIUM_COL_CHK_HORA=HORA
TITANIUM_COL_CHK_FECHAHORA=FECHAHORA
TITANIUM_COL_CHK_TIPO=TIPO
TITANIUM_COL_CHK_ORIGEN=ORIGEN
TITANIUM_VAL_ORIGEN_MOVIL=MOVIL

# ------------------------------------------------------------------------------
# Microservicio Facial Nativo (Python FastAPI + InsightFace ONNX)
# ------------------------------------------------------------------------------
FACIAL_SERVICE_URL=http://127.0.0.1:8001
FACIAL_SERVICE_TOKEN=local-facial-secret-change-me
FACIAL_TIMEOUT_SECONDS=12
FACIAL_THRESHOLD_1_1=0.45
FACIAL_THRESHOLD_1_N=0.48
FACIAL_MARGIN_1_N=0.08
FACIAL_MODEL_VERSION=buffalo_l_r100

# ------------------------------------------------------------------------------
# Reglas operativas y de seguridad
# ------------------------------------------------------------------------------
NONCE_TTL_SECONDS=90
DEBOUNCE_MINUTES=3
RATE_LIMIT_MAX_FAILS=8
RATE_LIMIT_WINDOW_MINUTES=10
DEFAULT_MAX_GPS_ACCURACY=120
